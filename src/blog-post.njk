---
pagination:
  data: blogPosts
  size: 1
  alias: post
permalink: "blog/{{ post.slug }}/index.html"
eleventyComputed:
  sbObjectId: "{{ post.objectPath }}"
---<!doctype html>
<html lang="lv" data-sb-object-id="{{ sbObjectId }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title data-sb-field-path="seo.title">{{ post.seo.title | default("Vandore Heritage - Bloga raksts") }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&family=Noto+Serif:wght@700&display=swap&subset=latin-ext" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/changes.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/fonts.css" />
</head>
<body class="page blog-detail-page">
  <header class="site-header bg-accent-primary py-4">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
      <a class="navbar-brand editable" href="/">
        <img class="editable editable-image" src="/image/red_LOGO_Vandore.png?v=2025" alt="Vandore Heritage" height="48" />
      </a>
      <nav class="d-flex gap-4 text-uppercase small fw-semibold">
        <a href="/" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/properties.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/rentals.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/blog.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/contact.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
      </nav>
    </div>
  </header>

  <main class="py-5" data-sb-object-id="{{ sbObjectId }}">
    <div class="container">
      <nav class="mb-4" aria-label="Atpakal uz blogu">
        <a class="link d-inline-flex align-items-center gap-2 editable" href="/blog.html"><span class="editable">Atpakal uz blogu</span></a>
      </nav>
            <article class="blog-post">
        <header class="mb-5">
          <p class="text-muted" data-sb-field-path="meta">{{ post.meta | default(post.date ~ " - " ~ post.readTime ~ " min - " ~ post.author) }}</p>
          <h1 class="display-5 fw-semibold" data-sb-field-path="title">{{ post.title }}</h1>
        </header>
        <figure class="mb-5">
          <img class="img-fluid rounded-4" src="{{ post.image | withLeadingSlash }}" alt="{{ post.imageAlt | default(post.title) }}" loading="lazy" data-sb-field-path="image">
        </figure>
        <div class="blog-post__body" data-sb-field-path="bodyHtml">{{ post.bodyHtml | safe }}</div>
        <div class="mt-5">
          <a class="btn btn-outline-secondary" href="/blog.html">Atpakal uz blogu</a>
        </div>
      </article>
    </div>
  </main>

  <footer class="bg-dark text-white py-4">
    <div class="container d-flex flex-wrap justify-content-between gap-3">
      <div>
        <p class="text-uppercase small mb-1 editable">Sazinaties</p>
        <a class="text-white text-decoration-none editable" href="mailto:info@vandoreheritage.lv"><span class="editable">Atpakal uz blogu</span></a>
      </div>
      <nav class="d-flex gap-3 text-uppercase small">
        <a href="/" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/properties.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/rentals.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/blog.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
        <a href="/contact.html" class="link text-white editable"><span class="editable">Atpakal uz blogu</span></a>
      </nav>
    </div>
  </footer>
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>





























